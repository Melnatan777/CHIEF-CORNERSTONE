<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Chief Cornerstone</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',sans-serif;background:#1A2E1A;min-height:100vh;display:flex;align-items:center;justify-content:center}
    .box{background:white;border-radius:16px;padding:40px;width:100%;max-width:400px;box-shadow:0 20px 60px rgba(0,0,0,.3)}
    .cross{font-size:2rem;color:#8BC34A;text-align:center;margin-bottom:8px}
    h1{font-family:'Playfair Display',serif;text-align:center;color:#1A2E1A;font-size:1.4rem;margin-bottom:4px}
    p{text-align:center;color:#9a9a8a;font-size:.85rem;margin-bottom:28px}
    label{display:block;font-weight:600;font-size:.85rem;color:#1A2E1A;margin-bottom:5px}
    input{width:100%;padding:11px 14px;border:2px solid #e8e0d0;border-radius:8px;font-size:.95rem;outline:none;margin-bottom:16px}
    input:focus{border-color:#1A2E1A}
    button{width:100%;padding:12px;background:#1A2E1A;color:white;border:none;border-radius:8px;font-size:.95rem;font-weight:700;cursor:pointer;margin-top:4px}
    button:hover{background:#0f1f0f}
    .error{background:#fdf0f0;color:#8B1A1A;border:1px solid #e0a0a0;padding:10px 14px;border-radius:8px;font-size:.85rem;margin-bottom:16px}
  </style>
</head>
<body>
  <div class="box">
    <div class="cross">✝</div>
    <h1>Chief Cornerstone</h1>
    <p>Business Admin Panel</p>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <label>Username</label>
      <input type="text" name="username" required autofocus>
      <label>Password</label>
      <input type="password" name="password" required>
      <button type="submit">Sign In</button>
    </form>
  </div>
</body>
</html>
