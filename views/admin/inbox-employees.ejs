<% pageTitle = 'Employee Inbox'; activeNav = 'inbox-employees'; layout = 'admin/layout' %>

<% if (saved) { %><div class="alert alert-success">✓ Message saved.</div><% } %>

<div style="display:grid;grid-template-columns:1fr 360px;gap:18px;align-items:start">

  <!-- Messages -->
  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
      <% if (unread > 0) { %>
      <span style="background:#fef2f2;color:#8B1A1A;font-size:.82rem;font-weight:700;padding:4px 12px;border-radius:20px;border:1px solid #fecaca"><%= unread %> Unread</span>
      <% } else { %>
      <span style="background:#dcfce7;color:#166534;font-size:.82rem;font-weight:700;padding:4px 12px;border-radius:20px">All Read</span>
      <% } %>
    </div>

    <% if (messages.length === 0) { %>
    <div class="card">
      <div class="empty-state">
        <div class="icon">👷</div>
        <h3>No employee messages yet</h3>
        <p>Log call-outs, schedule requests, and field notes here.</p>
      </div>
    </div>
    <% } else { %>
    <% messages.forEach(function(m) { %>
    <%
      const typeColor = m.type==='Call Out' ? '#8B1A1A' : m.type==='Urgent' ? '#8B1A1A' : m.type==='Schedule Request' ? '#D4A227' : '#1B3A1B';
      const typeBg = m.type==='Call Out'||m.type==='Urgent' ? '#fef2f2' : m.type==='Schedule Request' ? '#fef3c7' : '#f0f4f0';
    %>
    <div class="card" style="margin-bottom:10px;border-left:4px solid <%= m.status==='Unread' ? typeColor : '#dde8dd' %>;padding:16px 20px">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
        <div style="flex:1">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;flex-wrap:wrap">
            <div style="font-weight:700;font-size:.95rem;color:#1B3A1B"><%= m.employee_name || 'Unknown Employee' %></div>
            <span style="background:<%= typeBg %>;color:<%= typeColor %>;font-size:.7rem;font-weight:700;padding:2px 8px;border-radius:20px"><%= m.type %></span>
            <% if(m.status==='Unread'){ %><span class="badge badge-gold">New</span><% } %>
          </div>
          <% if(m.subject){ %><div style="font-weight:600;font-size:.88rem;color:#1B3A1B;margin-bottom:6px"><%= m.subject %></div><% } %>
          <div style="font-size:.88rem;color:#4a6a4a;line-height:1.65"><%= m.message %></div>
          <div style="font-size:.75rem;color:#9aaa9a;margin-top:8px"><%= m.created_at ? m.created_at.substring(0,16).replace('T',' ') : '' %></div>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0">
          <% if(m.status==='Unread'){ %>
          <form method="POST" action="/admin/inbox/employees/read/<%= m.id %>">
            <button class="btn btn-sm btn-ghost">Mark Read</button>
          </form>
          <% } %>
          <form method="POST" action="/admin/inbox/employees/delete/<%= m.id %>" onsubmit="return confirm('Delete?')">
            <button class="btn btn-sm btn-red">Delete</button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
    <% } %>
  </div>

  <!-- Log Message -->
  <div style="position:sticky;top:24px">
    <div class="card">
      <div class="card-header"><h2>+ Log Employee Message</h2></div>
      <p style="font-size:.82rem;color:#7a8a7a;margin-bottom:16px">Log call-outs, time-off requests, field notes, or urgent issues from crew members.</p>
      <form method="POST" action="/admin/inbox/employees/save">
        <div class="form-row"><label>Employee</label>
          <select name="employee_name">
            <option value="">Select employee...</option>
            <% employees.forEach(function(e){ %><option value="<%= e.name %>"><%= e.name %> — <%= e.role||'Crew' %></option><% }) %>
            <option value="Other">Other / Unknown</option>
          </select>
        </div>
        <div class="form-row"><label>Message Type</label>
          <select name="type">
            <option>General</option>
            <option>Call Out</option>
            <option>Schedule Request</option>
            <option>Field Note</option>
            <option>Urgent</option>
            <option>Time Off Request</option>
            <option>Equipment Issue</option>
          </select>
        </div>
        <div class="form-row"><label>Subject</label><input type="text" name="subject" placeholder="e.g. Called out sick Monday"></div>
        <div class="form-row"><label>Notes *</label><textarea name="message" required placeholder="What happened? What did they say?"></textarea></div>
        <div class="form-actions"><button type="submit" class="btn btn-green">Save Message</button></div>
      </form>
    </div>

    <!-- Type Legend -->
    <div class="card" style="margin-top:0">
      <div style="font-size:.72rem;font-weight:700;color:#7a8a7a;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px">Message Types</div>
      <% [['Call Out','#8B1A1A','#fef2f2'],['Urgent','#8B1A1A','#fef2f2'],['Schedule Request','#92400e','#fef3c7'],['Time Off Request','#92400e','#fef3c7'],['Field Note','#1B3A1B','#f0f4f0'],['Equipment Issue','#1a4a7a','#eff6ff'],['General','#1B3A1B','#f0f4f0']].forEach(function(t){ %>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
        <span style="background:<%= t[2] %>;color:<%= t[1] %>;font-size:.7rem;font-weight:700;padding:2px 8px;border-radius:20px"><%= t[0] %></span>
      </div>
      <% }) %>
    </div>
  </div>

</div>
