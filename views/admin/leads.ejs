<% pageTitle = 'Quote Requests'; activeNav = 'leads'; layout = 'admin/layout' %>

<div class="card">
  <div class="card-header"><h2>Quote Requests (<%= leads.length %>)</h2></div>
  <% if (leads.length === 0) { %>
  <div class="empty-state"><div class="icon">📋</div><p>No quote requests yet.</p></div>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Date</th><th>Name</th><th>Phone</th><th>ZIP</th><th>Service</th><th>Message</th><th></th></tr></thead>
      <tbody>
        <% leads.forEach(l => { %>
        <tr>
          <td style="color:#7a7a6a;font-size:.82rem;white-space:nowrap"><%= l.created_at ? l.created_at.substring(0,10) : '—' %></td>
          <td style="font-weight:600"><%= l.name || '—' %></td>
          <td><%= l.phone || '—' %></td>
          <td><%= l.zip || '—' %></td>
          <td><%= l.service || '—' %></td>
          <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= l.message || '—' %></td>
          <td>
            <form method="POST" action="/admin/leads/delete/<%= l.id %>" style="display:inline" onsubmit="return confirm('Delete this lead?')">
              <button class="btn btn-sm btn-red">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
