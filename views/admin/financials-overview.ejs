<% pageTitle = 'P&L Overview'; activeNav = 'profitloss'; layout = 'admin/layout' %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<%
const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const revenueByMonth = {}, expenseByMonth = {};
monthNames.forEach(m => { revenueByMonth[m]=0; expenseByMonth[m]=0; });
jobs.forEach(j => {
  if(j.status==='Completed'&&j.scheduled_date){ const m=monthNames[new Date(j.scheduled_date).getMonth()]; revenueByMonth[m]+=(parseFloat(j.price)||0); }
});
expenses.forEach(e => {
  if(e.date){ const m=monthNames[new Date(e.date).getMonth()]; expenseByMonth[m]+=(parseFloat(e.amount)||0); }
});
const totalRevenue = jobs.filter(j=>j.status==='Completed').reduce((s,j)=>s+(parseFloat(j.price)||0),0);
const totalExpenses = expenses.reduce((s,e)=>s+(parseFloat(e.amount)||0),0);
const grossProfit = totalRevenue - totalExpenses;
const laborCost = expenses.filter(e=>e.category==='Labor').reduce((s,e)=>s+(parseFloat(e.amount)||0),0);
const fuelCost = expenses.filter(e=>e.category==='Fuel/Gas').reduce((s,e)=>s+(parseFloat(e.amount)||0),0);
const overhead = expenses.filter(e=>['Overhead','Insurance','Vehicle','Equipment','Marketing'].includes(e.category)).reduce((s,e)=>s+(parseFloat(e.amount)||0),0);
const estTax = grossProfit > 0 ? grossProfit * 0.25 : 0;
const netAfterTax = grossProfit - estTax;
%>

<div style="background:#f0f4f0;border-left:4px solid #1B3A1B;border-radius:0 10px 10px 0;padding:12px 16px;margin-bottom:20px;font-size:.85rem;color:#1B3A1B">
  This is your business profit & loss summary. For full tax filing, export this data to QuickBooks or your accountant.
</div>

<!-- P&L Summary Cards -->
<div class="stats-grid" style="margin-bottom:20px">
  <div class="stat-card green">
    <div class="stat-number">$<%= totalRevenue.toLocaleString('en-US',{minimumFractionDigits:0}) %></div>
    <div class="stat-label">Gross Revenue</div>
    <div class="stat-sub" style="color:#228B22">Completed jobs</div>
  </div>
  <div class="stat-card red">
    <div class="stat-number">$<%= totalExpenses.toLocaleString('en-US',{minimumFractionDigits:0}) %></div>
    <div class="stat-label">Total Expenses</div>
  </div>
  <div class="stat-card <%= grossProfit >= 0 ? 'gold' : 'red' %>">
    <div class="stat-number" style="<%= grossProfit < 0 ? 'color:#8B1A1A' : '' %>">$<%= grossProfit.toLocaleString('en-US',{minimumFractionDigits:0}) %></div>
    <div class="stat-label">Gross Profit</div>
  </div>
  <div class="stat-card">
    <div class="stat-number" style="color:#8B1A1A">$<%= estTax.toLocaleString('en-US',{minimumFractionDigits:0}) %></div>
    <div class="stat-label">Est. Tax (25%)</div>
    <div class="stat-sub" style="color:#9aaa9a">Estimate only</div>
  </div>
  <div class="stat-card green">
    <div class="stat-number" style="<%= netAfterTax < 0 ? 'color:#8B1A1A' : '' %>">$<%= netAfterTax.toLocaleString('en-US',{minimumFractionDigits:0}) %></div>
    <div class="stat-label">Est. Net Profit</div>
    <div class="stat-sub" style="color:#228B22">After est. tax</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px">
  <!-- P&L Chart -->
  <div class="card">
    <div class="card-header"><h2>📈 Revenue vs Expenses — Monthly</h2></div>
    <canvas id="plChart" height="220"></canvas>
  </div>

  <!-- Expense Breakdown -->
  <div class="card">
    <div class="card-header"><h2>💸 Expense Breakdown</h2></div>
    <div style="display:grid;gap:8px">
      <% [
        ['Labor / Payroll', laborCost, '#8B1A1A'],
        ['Fuel / Gas', fuelCost, '#D4A227'],
        ['Overhead', overhead, '#1a4a7a'],
        ['Other', totalExpenses - laborCost - fuelCost - overhead, '#7a8a7a']
      ].forEach(function(row) { if(row[1] > 0) { %>
      <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:#f8faf8;border-radius:8px">
        <div style="width:10px;height:10px;border-radius:50%;background:<%= row[2] %>;flex-shrink:0"></div>
        <div style="flex:1;font-size:.88rem;font-weight:600;color:#1B3A1B"><%= row[0] %></div>
        <div style="font-weight:700;font-size:.9rem;color:<%= row[2] %>">$<%= row[1].toLocaleString('en-US',{minimumFractionDigits:2}) %></div>
        <div style="font-size:.78rem;color:#9aaa9a"><%= totalExpenses > 0 ? Math.round((row[1]/totalExpenses)*100) : 0 %>%</div>
      </div>
      <% }} ) %>
    </div>
  </div>
</div>

<!-- Full P&L Statement -->
<div class="card">
  <div class="card-header">
    <h2>📄 Profit & Loss Statement</h2>
    <button onclick="window.print()" class="btn btn-sm btn-ghost">🖨️ Print / Export</button>
  </div>
  <table>
    <tbody>
      <tr style="background:#f0f4f0"><td colspan="2" style="font-weight:700;color:#1B3A1B;font-size:.85rem;text-transform:uppercase;letter-spacing:.5px">INCOME</td></tr>
      <tr><td style="padding-left:24px">Job Revenue (Completed)</td><td style="text-align:right;font-weight:700;color:#228B22">$<%= totalRevenue.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>
      <tr style="background:#f8faf8"><td style="font-weight:700">Gross Revenue</td><td style="text-align:right;font-weight:800;color:#228B22">$<%= totalRevenue.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>

      <tr style="background:#f0f4f0"><td colspan="2" style="font-weight:700;color:#1B3A1B;font-size:.85rem;text-transform:uppercase;letter-spacing:.5px;padding-top:12px">EXPENSES</td></tr>
      <tr><td style="padding-left:24px">Labor & Payroll</td><td style="text-align:right;color:#8B1A1A">($<%= laborCost.toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>
      <tr><td style="padding-left:24px">Fuel & Gas</td><td style="text-align:right;color:#8B1A1A">($<%= fuelCost.toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>
      <tr><td style="padding-left:24px">Equipment & Supplies</td><td style="text-align:right;color:#8B1A1A">($<%= expenses.filter(e=>['Equipment','Supplies'].includes(e.category)).reduce((s,e)=>s+(parseFloat(e.amount)||0),0).toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>
      <tr><td style="padding-left:24px">Vehicle & Insurance</td><td style="text-align:right;color:#8B1A1A">($<%= expenses.filter(e=>['Vehicle','Insurance'].includes(e.category)).reduce((s,e)=>s+(parseFloat(e.amount)||0),0).toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>
      <tr><td style="padding-left:24px">Marketing</td><td style="text-align:right;color:#8B1A1A">($<%= expenses.filter(e=>e.category==='Marketing').reduce((s,e)=>s+(parseFloat(e.amount)||0),0).toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>
      <tr><td style="padding-left:24px">Overhead & Other</td><td style="text-align:right;color:#8B1A1A">($<%= expenses.filter(e=>['Overhead','Other'].includes(e.category)).reduce((s,e)=>s+(parseFloat(e.amount)||0),0).toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>
      <tr style="background:#f8faf8"><td style="font-weight:700">Total Expenses</td><td style="text-align:right;font-weight:800;color:#8B1A1A">($<%= totalExpenses.toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>

      <tr style="background:#1B3A1B"><td style="font-weight:800;color:white;font-size:.95rem">GROSS PROFIT</td><td style="text-align:right;font-weight:800;color:<%= grossProfit>=0?'#8BC34A':'#ff6b6b' %>;font-size:.95rem">$<%= grossProfit.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>

      <tr style="background:#f0f4f0"><td colspan="2" style="font-weight:700;color:#1B3A1B;font-size:.85rem;text-transform:uppercase;letter-spacing:.5px;padding-top:12px">TAX ESTIMATE</td></tr>
      <tr><td style="padding-left:24px">Self-Employment Tax (15.3%)</td><td style="text-align:right;color:#8B1A1A">($<%= (grossProfit*0.153).toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>
      <tr><td style="padding-left:24px">Federal Income Tax (est. 22%)</td><td style="text-align:right;color:#8B1A1A">($<%= (grossProfit*0.22).toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>
      <tr style="background:#f8faf8"><td style="font-weight:700">Total Est. Tax Liability</td><td style="text-align:right;font-weight:800;color:#8B1A1A">($<%= estTax.toLocaleString('en-US',{minimumFractionDigits:2}) %>)</td></tr>

      <tr style="background:#1B3A1B"><td style="font-weight:800;color:white;font-size:.95rem">ESTIMATED NET PROFIT</td><td style="text-align:right;font-weight:800;color:<%= netAfterTax>=0?'#8BC34A':'#ff6b6b' %>;font-size:.95rem">$<%= netAfterTax.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>
    </tbody>
  </table>
  <div style="margin-top:14px;padding:12px 16px;background:#fef3c7;border-radius:8px;font-size:.8rem;color:#92400e">
    ⚠️ Tax estimates are for planning purposes only. Consult your accountant or CPA for actual tax filing. Export this data to QuickBooks for professional accounting.
  </div>
</div>

<script>
new Chart(document.getElementById('plChart'),{
  type:'bar',
  data:{labels:<%- JSON.stringify(monthNames) %>,datasets:[
    {label:'Revenue',data:<%- JSON.stringify(monthNames.map(m=>Math.round(revenueByMonth[m]||0))) %>,backgroundColor:'#228B2288',borderColor:'#228B22',borderWidth:2,borderRadius:6},
    {label:'Expenses',data:<%- JSON.stringify(monthNames.map(m=>Math.round(expenseByMonth[m]||0))) %>,backgroundColor:'#8B1A1A88',borderColor:'#8B1A1A',borderWidth:2,borderRadius:6}
  ]},
  options:{responsive:true,plugins:{legend:{position:'top'}},scales:{y:{beginAtZero:true,ticks:{callback:v=>'$'+v}}}}
});
</script>
