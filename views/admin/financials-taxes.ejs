<% pageTitle = 'Tax Summary'; activeNav = 'taxes'; layout = 'admin/layout' %>

<%
const totalRevenue = jobs.reduce((s,j)=>s+(parseFloat(j.price)||0),0);
const totalExpenses = expenses.reduce((s,e)=>s+(parseFloat(e.amount)||0),0);
const grossProfit = totalRevenue - totalExpenses;
const selfEmploymentTax = Math.max(0, grossProfit * 0.9235 * 0.153);
const federalTax = Math.max(0, grossProfit * 0.22);
const stateTax = 0; // Texas has no state income tax
const totalTax = selfEmploymentTax + federalTax;
const netProfit = grossProfit - totalTax;
const qtrPayment = totalTax / 4;
%>

<div style="background:#dcfce7;border-left:4px solid #228B22;border-radius:0 10px 10px 0;padding:12px 16px;margin-bottom:20px;font-size:.85rem;color:#166534;font-weight:600">
  ✓ Good news — Texas has NO state income tax. Your tax burden is lower than most states.
</div>

<div class="stats-grid" style="margin-bottom:20px">
  <div class="stat-card green"><div class="stat-number">$<%= totalRevenue.toLocaleString('en-US',{minimumFractionDigits:0}) %></div><div class="stat-label">Gross Revenue</div></div>
  <div class="stat-card red"><div class="stat-number">$<%= totalExpenses.toLocaleString('en-US',{minimumFractionDigits:0}) %></div><div class="stat-label">Total Deductions</div></div>
  <div class="stat-card gold"><div class="stat-number">$<%= grossProfit.toLocaleString('en-US',{minimumFractionDigits:0}) %></div><div class="stat-label">Net Taxable Income</div></div>
  <div class="stat-card red"><div class="stat-number">$<%= totalTax.toLocaleString('en-US',{minimumFractionDigits:0}) %></div><div class="stat-label">Est. Total Tax</div></div>
  <div class="stat-card"><div class="stat-number">$<%= qtrPayment.toLocaleString('en-US',{minimumFractionDigits:0}) %></div><div class="stat-label">Quarterly Payment</div><div class="stat-sub" style="color:#9aaa9a">Est. due dates below</div></div>
</div>

<div style="display:grid;grid-template-columns:1fr 340px;gap:18px">
  <div>
    <!-- Tax Breakdown -->
    <div class="card" style="margin-bottom:16px">
      <div class="card-header"><h2>📋 Tax Estimate Breakdown</h2>
        <button onclick="window.print()" class="btn btn-sm btn-ghost">🖨️ Print</button>
      </div>
      <table>
        <tbody>
          <tr style="background:#f0f4f0"><td colspan="2" style="font-weight:700;color:#1B3A1B;text-transform:uppercase;font-size:.82rem;letter-spacing:.5px">INCOME</td></tr>
          <tr><td>Gross Revenue</td><td style="text-align:right;font-weight:700">$<%= totalRevenue.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>
          <tr><td>Business Deductions (Expenses)</td><td style="text-align:right;color:#228B22">- $<%= totalExpenses.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>
          <tr style="background:#f8faf8"><td style="font-weight:700">Net Profit (Taxable Income)</td><td style="text-align:right;font-weight:800">$<%= grossProfit.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>

          <tr style="background:#f0f4f0"><td colspan="2" style="font-weight:700;color:#1B3A1B;text-transform:uppercase;font-size:.82rem;letter-spacing:.5px;padding-top:12px">TAXES</td></tr>
          <tr><td>Self-Employment Tax (15.3% of 92.35%)</td><td style="text-align:right;color:#8B1A1A">$<%= selfEmploymentTax.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>
          <tr><td>Federal Income Tax (est. 22%)</td><td style="text-align:right;color:#8B1A1A">$<%= federalTax.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>
          <tr><td>Texas State Income Tax</td><td style="text-align:right;color:#228B22;font-weight:700">$0.00 ✓</td></tr>
          <tr style="background:#f8faf8"><td style="font-weight:700">Total Estimated Tax</td><td style="text-align:right;font-weight:800;color:#8B1A1A">$<%= totalTax.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>

          <tr style="background:#1B3A1B"><td style="color:white;font-weight:800;font-size:.95rem">ESTIMATED NET PROFIT AFTER TAX</td><td style="text-align:right;color:<%= netProfit>=0?'#8BC34A':'#ff6b6b' %>;font-weight:800;font-size:.95rem">$<%= netProfit.toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>
        </tbody>
      </table>
      <div style="margin-top:12px;padding:10px 14px;background:#fef3c7;border-radius:8px;font-size:.78rem;color:#92400e">
        ⚠️ These are estimates for planning only — actual tax liability depends on your filing status, deductions, and other income. Always consult a licensed CPA or tax professional.
      </div>
    </div>

    <!-- Deductible Expenses -->
    <div class="card">
      <div class="card-header"><h2>✅ Deductible Business Expenses</h2></div>
      <p style="font-size:.85rem;color:#7a8a7a;margin-bottom:14px">Every expense logged reduces your taxable income. Keep receipts for all of these.</p>
      <div style="display:grid;gap:6px">
        <% [
          ['Fuel & Gas','Fully deductible — keep all fuel receipts'],
          ['Equipment & Tools','Deductible — may qualify for Section 179 full deduction'],
          ['Vehicle','Business-use portion deductible — track mileage'],
          ['Insurance','Fully deductible — liability, vehicle, workers comp'],
          ['Marketing','Fully deductible — website, ads, business cards'],
          ['Labor / Payroll','Fully deductible — all employee wages and contract labor'],
          ['Overhead','Deductible — phone, software, office supplies']
        ].forEach(function(d){ %>
        <div style="display:flex;gap:10px;padding:9px 12px;background:#f8faf8;border-radius:8px">
          <span style="color:#228B22;font-weight:700;flex-shrink:0">✓</span>
          <div>
            <div style="font-weight:700;font-size:.85rem;color:#1B3A1B"><%= d[0] %></div>
            <div style="font-size:.75rem;color:#7a8a7a"><%= d[1] %></div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Quarterly Due Dates -->
  <div>
    <div class="card" style="margin-bottom:14px">
      <div class="card-header"><h2>📅 Quarterly Tax Due Dates</h2></div>
      <% [
        ['Q1 2026','April 15, 2026','Jan 1 – Mar 31'],
        ['Q2 2026','June 16, 2026','Apr 1 – May 31'],
        ['Q3 2026','September 15, 2026','Jun 1 – Aug 31'],
        ['Q4 2026','January 15, 2027','Sep 1 – Dec 31']
      ].forEach(function(q){ %>
      <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:#f8faf8;border-radius:8px;margin-bottom:6px;border-left:3px solid #D4A227">
        <div style="flex:1">
          <div style="font-weight:700;font-size:.88rem;color:#1B3A1B"><%= q[0] %></div>
          <div style="font-size:.75rem;color:#7a8a7a"><%= q[2] %></div>
        </div>
        <div style="text-align:right">
          <div style="font-weight:700;font-size:.82rem;color:#D4A227">Due <%= q[1] %></div>
          <div style="font-size:.78rem;color:#9aaa9a">~$<%= qtrPayment.toLocaleString('en-US',{minimumFractionDigits:0}) %></div>
        </div>
      </div>
      <% }) %>
    </div>

    <div style="background:#1B3A1B;border-radius:12px;padding:18px;color:white">
      <div style="color:#8BC34A;font-size:.72rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px">💡 Tax Pro Tip</div>
      <p style="font-size:.82rem;color:rgba(255,255,255,.8);line-height:1.7">Set aside <strong style="color:#8BC34A">25–30%</strong> of every payment you receive. Transfer it to a separate savings account the same day. When quarterly taxes come due, the money is already there.</p>
    </div>
  </div>
</div>
